/* Относительное понятие (отношение) предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

rrel_predator
<- sc_node_role_relation;
<- relation;
<- role_relation;
<- concept_wit_entity;
=> nrel_main_idtf:
	[хищник'] (* <- lang_ru;; *);
	[predator'] (* <- lang_en;; *);
=> nrel_note:
	[Ролевое отношение, указывающее на компонент связки хищничества, который является хищником.] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (хищник)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Хищник' — ролевое отношение, определяющее роль хищника в связке акта хищничества.] (* <- lang_ru;; *);;
			*);;
	*);;
