/* Относительное понятие (отношение) предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

rrel_symbiont
<- sc_node_role_relation;
<- relation;
<- role_relation;
<- concept_wit_entity;
=> nrel_main_idtf:
	[симбионт'] (* <- lang_ru;; *);
	[symbiont'] (* <- lang_en;; *);
=> nrel_note:
	[Ролевое отношение, указывающее на компонент связки симбиоза, который является симбионтом.] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (симбионт)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Симбионт' — ролевое отношение, определяющее роль симбионта в связке симбиотических взаимоотношений.] (* <- lang_ru;; *);;
			*);;
	*);;
