/* Относительное понятие (отношение) предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

rrel_place
<- sc_node_role_relation;
<- relation;
<- role_relation;
<- concept_wit_entity;
=> nrel_main_idtf:
	[место'] (* <- lang_ru;; *);
	[place'] (* <- lang_en;; *);
=> nrel_note:
	[Ролевое отношение, указывающее на компонент связки, который является местом происходящего события.] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (место)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Место' — ролевое отношение, определяющее роль места события в связке.] (* <- lang_ru;; *);;
			*);;
	*);;
