/* Относительное понятие (отношение) предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

nrel_conservation_status
<- sc_node_non_role_relation;
<- relation;
<- concept_wit_entity;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[охранный статус*] (* <- lang_ru;; *);
	[conservation status*] (* <- lang_en;; *);
=> nrel_note:
	[Связывает биологический вид с присвоенной ему категорией риска исчезновения.] (* <- lang_ru;; *);
=> nrel_first_domain: concept_biological_species;
=> nrel_second_domain: concept_conservation_status;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_biological_species;
				concept_conservation_status
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (охранный статус)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Охранный статус* — бинарное ориентированное отношение, связывающее биологический вид и категорию, отражающую вероятность его исчезновения.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_biological_species;
				concept_conservation_status
			};;
	*);;
