/* Относительное понятие (отношение) предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

nrel_domestication
<- sc_node_non_role_relation;
<- relation;
<- concept_wit_entity;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[одомашнивание*] (* <- lang_ru;; *);
	[domestication*] (* <- lang_en;; *);
=> nrel_note:
	[Связывает дикого предка с домашним животным, полученным в результате его одомашнивания.] (* <- lang_ru;; *);
=> nrel_first_domain: concept_wild_animal;
=> nrel_second_domain: concept_domestic_animal;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_wild_animal;
				concept_domestic_animal
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (одомашнивание)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Одомашнивание* — бинарное ориентированное отношение, связывающее дикое животное и домашнее животное, происходящее от него в результате многовекового отбора человеком.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_wild_animal;
				concept_domestic_animal
			};;
	*);;
