/* Относительное понятие (отношение) предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

nrel_population
<- sc_node_non_role_relation;
<- relation;
<- concept_wit_entity;
<- non_binary_relation;
<- oriented_relation;
<- antireflexive_relation;
=> nrel_main_idtf:
	[популяция вида в экосистеме*] (* <- lang_ru;; *);
	[population of species in ecosystem*] (* <- lang_en;; *);
=> nrel_note:
	[Небинарное ориентированное отношение, связывающее биологический вид, экосистему и численность популяции этого вида в этой экосистеме.] (* <- lang_ru;; *);
=> nrel_first_domain: concept_biological_species;
=> nrel_second_domain: concept_ecosystem;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_biological_species;
				concept_ecosystem
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (популяция вида в экосистеме)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Популяция вида в экосистеме* — небинарное ориентированное отношение, каждая связка которого связывает биологический вид, экосистему, в которой он обитает, и численность его популяции в этой экосистеме.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_biological_species;
				concept_ecosystem
			};;
	*);;
