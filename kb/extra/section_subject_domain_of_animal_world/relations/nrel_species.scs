/* Относительное понятие (отношение) предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

nrel_species
<- sc_node_non_role_relation;
<- relation;
<- concept_wit_entity;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[вид*] (* <- lang_ru;; *);
	[species*] (* <- lang_en;; *);
=> nrel_note:
	[Связывает животное с биологическим видом, к которому оно относится.] (* <- lang_ru;; *);
=> nrel_first_domain: concept_animal;
=> nrel_second_domain: concept_biological_species;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_animal;
				concept_biological_species
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (вид)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Вид* — бинарное ориентированное отношение, связывающее животное и биологический вид, экземпляром которого это животное является.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_animal;
				concept_biological_species
			};;
	*);;
