/* Относительное понятие (отношение) предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

nrel_morphological_feature
<- sc_node_non_role_relation;
<- relation;
<- concept_wit_entity;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[характерный признак*] (* <- lang_ru;; *);
	[morphological feature*] (* <- lang_en;; *);
=> nrel_note:
	[Связывает животное с характерной особенностью строения его тела.] (* <- lang_ru;; *);
=> nrel_first_domain: concept_animal;
=> nrel_second_domain: concept_morphological_feature;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_animal;
				concept_morphological_feature
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (характерный признак)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Характерный признак* — бинарное ориентированное отношение, связывающее животное и особенность внешнего строения, отличающую его от животных других видов.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_animal;
				concept_morphological_feature
			};;
	*);;
