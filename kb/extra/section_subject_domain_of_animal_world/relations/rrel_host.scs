/* Относительное понятие (отношение) предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

rrel_host
<- sc_node_role_relation;
<- relation;
<- role_relation;
<- concept_wit_entity;
=> nrel_main_idtf:
	[хозяин'] (* <- lang_ru;; *);
	[host'] (* <- lang_en;; *);
=> nrel_note:
	[Ролевое отношение, указывающее на компонент связки симбиоза или паразитизма, который является организмом-хозяином.] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (хозяин)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Хозяин' — ролевое отношение, определяющее роль организма-хозяина в связке симбиотических или паразитических взаимоотношений.] (* <- lang_ru;; *);;
			*);;
	*);;
