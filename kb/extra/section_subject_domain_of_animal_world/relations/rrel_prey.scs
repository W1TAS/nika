/* Относительное понятие (отношение) предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

rrel_prey
<- sc_node_role_relation;
<- relation;
<- role_relation;
<- concept_wit_entity;
=> nrel_main_idtf:
	[жертва'] (* <- lang_ru;; *);
	[prey'] (* <- lang_en;; *);
=> nrel_note:
	[Ролевое отношение, указывающее на компонент связки хищничества, который является жертвой.] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (жертва)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Жертва' — ролевое отношение, определяющее роль жертвы в связке акта хищничества.] (* <- lang_ru;; *);;
			*);;
	*);;
