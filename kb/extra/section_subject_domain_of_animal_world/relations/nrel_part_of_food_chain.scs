/* Относительное понятие (отношение) предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

nrel_part_of_food_chain
<- sc_node_non_role_relation;
<- relation;
<- concept_wit_entity;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[участие в пищевой цепи*] (* <- lang_ru;; *);
	[part of food chain*] (* <- lang_en;; *);
=> nrel_note:
	[Связывает животное с пищевой цепью, звеном которой оно является.] (* <- lang_ru;; *);
=> nrel_first_domain: concept_animal;
=> nrel_second_domain: concept_food_chain;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_animal;
				concept_food_chain
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (участие в пищевой цепи)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Участие в пищевой цепи* — бинарное ориентированное отношение, связывающее животное и пищевую цепь, одним из звеньев которой это животное является.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_animal;
				concept_food_chain
			};;
	*);;
