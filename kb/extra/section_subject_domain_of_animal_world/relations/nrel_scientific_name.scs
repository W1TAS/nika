/* Относительное понятие (отношение) предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

nrel_scientific_name
<- sc_node_non_role_relation;
<- relation;
<- concept_wit_entity;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[научное название*] (* <- lang_ru;; *);
	[scientific name*] (* <- lang_en;; *);
=> nrel_note:
	[Связывает животное или таксон с его латинским (биномиальным) названием.] (* <- lang_ru;; *);
=> nrel_first_domain: concept_taxon;
=> nrel_second_domain: sc_link;
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (научное название)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Научное название* — бинарное ориентированное отношение, связывающее таксон с его общепринятым латинским названием.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_taxon
			};;
	*);;
