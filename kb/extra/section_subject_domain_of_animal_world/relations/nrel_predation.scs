/* Относительное понятие (отношение) предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

nrel_predation
<- sc_node_non_role_relation;
<- relation;
<- concept_wit_entity;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[хищничество*] (* <- lang_ru;; *);
	[predation*] (* <- lang_en;; *);
=> nrel_note:
	[Связывает хищника с животным, на которое он охотится.] (* <- lang_ru;; *);
=> nrel_first_domain: concept_predator;
=> nrel_second_domain: concept_prey;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_predator;
				concept_prey
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (хищничество)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Хищничество* — бинарное ориентированное отношение, связывающее хищника и жертву, на которую он охотится.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_predator;
				concept_prey
			};;
	*);;
