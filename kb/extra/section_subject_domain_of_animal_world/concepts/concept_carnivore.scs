/* Абсолютное понятие предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

concept_carnivore
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[плотоядное животное] (* <- lang_ru;; *);
	[carnivore] (* <- lang_en;; *);
=> nrel_note:
	[Плотоядные — животные, основу рациона которых составляет мясо других животных.] (* <- lang_ru;; *);
<= nrel_inclusion: concept_animal;
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (плотоядное животное)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Плотоядное животное — животное, рацион которого состоит преимущественно из пищи животного происхождения.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_animal;
				concept_food_type
			};;
	*);;
