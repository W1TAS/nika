/* Абсолютное понятие предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

concept_omnivore
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[всеядное животное] (* <- lang_ru;; *);
	[omnivore] (* <- lang_en;; *);
=> nrel_note:
	[Всеядные — животные, употребляющие в пищу как растительную, так и животную пищу.] (* <- lang_ru;; *);
<= nrel_inclusion: concept_animal;
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (всеядное животное)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Всеядное животное — животное, рацион которого включает как растительную, так и животную пищу.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_animal;
				concept_food_type
			};;
	*);;
