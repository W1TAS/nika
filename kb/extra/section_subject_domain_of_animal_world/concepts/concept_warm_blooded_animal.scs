/* Абсолютное понятие предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

concept_warm_blooded_animal
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[теплокровное животное] (* <- lang_ru;; *);
	[warm-blooded animal] (* <- lang_en;; *);
=> nrel_note:
	[Теплокровные животные поддерживают постоянную температуру тела независимо от температуры окружающей среды.] (* <- lang_ru;; *);
<= nrel_inclusion: concept_animal;
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (теплокровное животное)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Теплокровное животное — животное, способное поддерживать постоянную температуру тела за счёт собственного обмена веществ.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_animal
			};;
	*);;
