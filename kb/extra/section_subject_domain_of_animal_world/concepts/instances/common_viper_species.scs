/* Видовая сущность для связей предметной области животного мира. */

common_viper_species
<- concept_wit_entity;
<- concept_biological_species;
=> nrel_main_idtf:
    [обыкновенная гадюка (вид)] (* <- lang_ru;; *);
    [Vipera berus] (* <- lang_en;; *);
=> nrel_scientific_name:
    [Vipera berus] (* <- lang_en;; *);
=> nrel_conservation_status: status_least_concern;
=> nrel_note:
    [биологический вид, научное название которого — Vipera berus] (* <- lang_ru;; *);;
