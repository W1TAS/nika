/* Видовая сущность для связей предметной области животного мира. */

nile_crocodile_species
<- concept_wit_entity;
<- concept_biological_species;
=> nrel_main_idtf:
    [нильский крокодил (вид)] (* <- lang_ru;; *);
    [Crocodylus niloticus] (* <- lang_en;; *);
=> nrel_scientific_name:
    [Crocodylus niloticus] (* <- lang_en;; *);
=> nrel_conservation_status: status_least_concern;
=> nrel_note:
    [биологический вид, научное название которого — Crocodylus niloticus] (* <- lang_ru;; *);;
