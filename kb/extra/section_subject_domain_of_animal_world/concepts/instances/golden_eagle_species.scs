/* Видовая сущность для связей предметной области животного мира. */

golden_eagle_species
<- concept_wit_entity;
<- concept_biological_species;
=> nrel_main_idtf:
    [беркут (вид)] (* <- lang_ru;; *);
    [Aquila chrysaetos] (* <- lang_en;; *);
=> nrel_scientific_name:
    [Aquila chrysaetos] (* <- lang_en;; *);
=> nrel_conservation_status: status_least_concern;
=> nrel_note:
    [биологический вид, научное название которого — Aquila chrysaetos] (* <- lang_ru;; *);;
