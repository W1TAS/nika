/* Видовая сущность для связей предметной области животного мира. */

domestic_dog_species
<- concept_wit_entity;
<- concept_biological_species;
=> nrel_main_idtf:
    [домашняя собака (вид)] (* <- lang_ru;; *);
    [Canis familiaris] (* <- lang_en;; *);
=> nrel_scientific_name:
    [Canis familiaris] (* <- lang_en;; *);
=> nrel_conservation_status: status_not_evaluated;
=> nrel_note:
    [биологический вид, научное название которого — Canis familiaris] (* <- lang_ru;; *);;
