/* Экземпляры понятий предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

aurochs
<- concept_wit_entity;
<- concept_animal;
<- concept_mammal;
<- concept_herbivore;
<- concept_wild_animal;
=> nrel_main_idtf:
	[тур] (* <- lang_ru;; *);
	[aurochs] (* <- lang_en;; *);
=> nrel_note:
	[Тур — вымерший дикий бык, предок современного крупного рогатого скота; последняя особь погибла в 1627 году в Польше.] (* <- lang_ru;; *);
=> nrel_scientific_name:
	[Bos primigenius] (* <- lang_en;; *);
=> nrel_species: bos_primigenius;
=> nrel_food_type: food_type_herbivory;
=> nrel_morphological_feature: feature_horn;
=> nrel_domestication: domestic_cow;;
