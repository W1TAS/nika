/* Видовая сущность для связей предметной области животного мира. */

blue_shark_species
<- concept_wit_entity;
<- concept_biological_species;
=> nrel_main_idtf:
    [синяя акула (вид)] (* <- lang_ru;; *);
    [Prionace glauca] (* <- lang_en;; *);
=> nrel_scientific_name:
    [Prionace glauca] (* <- lang_en;; *);
=> nrel_conservation_status: status_near_threatened;
=> nrel_note:
    [биологический вид, научное название которого — Prionace glauca] (* <- lang_ru;; *);;
