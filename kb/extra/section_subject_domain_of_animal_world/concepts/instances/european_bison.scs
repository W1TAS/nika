/* Экземпляры понятий предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

european_bison
<- concept_wit_entity;
<- concept_animal;
<- concept_mammal;
<- concept_herbivore;
<- concept_wild_animal;
<- concept_warm_blooded_animal;
<- concept_viviparous_animal;
=> nrel_main_idtf:
	[зубр] (* <- lang_ru;; *);
	[European bison] (* <- lang_en;; *);
=> nrel_note:
	[Зубр — самое крупное наземное млекопитающее Европы, сохранённое от полного истребления благодаря разведению в Беловежской пуще.] (* <- lang_ru;; *);
=> nrel_scientific_name:
	[Bison bonasus] (* <- lang_en;; *);
=> nrel_body_mass:
	[до 920 кг] (* <- lang_ru;; *);
=> nrel_species: bison_bonasus;
=> nrel_habitat: mixed_forest;
=> nrel_food_type: food_type_herbivory;
=> nrel_part_of_food_chain: forest_food_chain;
=> nrel_morphological_feature: feature_horn;
=> nrel_body_covering: covering_wool;;
