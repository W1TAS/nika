	[Млекопитающие] (* <- lang_ru;; *);
	[Mammalia] (* <- lang_en;; *);
=> nrel_note:
	[Млекопитающие — класс позвоночных животных, самки которых выкармливают детёнышей молоком.] (* <- lang_ru;; *);
=> nrel_scientific_name:
	[Mammalia] (* <- lang_en;; *);
=> nrel_parent_taxon: chordata;;
