bovidae
<- concept_wit_entity;
<- concept_taxon;
=> nrel_main_idtf:
	[Полорогие] (* <- lang_ru;; *);
	[Bovidae] (* <- lang_en;; *);
=> nrel_note:
	[семейство парнокопытных, у представителей которого рога образованы костным стержнем и роговым чехлом] (* <- lang_ru;; *);
=> nrel_scientific_name:
	[Bovidae] (* <- lang_en;; *);
=> nrel_parent_taxon: artiodactyla;;
