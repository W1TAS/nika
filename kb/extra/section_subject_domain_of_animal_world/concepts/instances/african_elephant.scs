/* Экземпляры понятий предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

african_elephant
<- concept_wit_entity;
<- concept_animal;
<- concept_mammal;
<- concept_herbivore;
<- concept_wild_animal;
<- concept_warm_blooded_animal;
<- concept_viviparous_animal;
=> nrel_main_idtf:
	[африканский слон] (* <- lang_ru;; *);
	[African elephant] (* <- lang_en;; *);
=> nrel_note:
	[крупнейшее наземное животное планеты; хобот служит ему одновременно органом обоняния, осязания и захвата пищи] (* <- lang_ru;; *);
=> nrel_scientific_name:
	[Loxodonta africana] (* <- lang_en;; *);
=> nrel_body_mass:
	[до 7 т] (* <- lang_ru;; *);
=> nrel_habitat: savanna;
=> nrel_food_type: food_type_herbivory;
=> nrel_morphological_feature: feature_trunk;
=> nrel_species: african_elephant_species;
=> nrel_behaviour: behaviour_migration;
=> nrel_reproduction_type: reproduction_viviparity;;
