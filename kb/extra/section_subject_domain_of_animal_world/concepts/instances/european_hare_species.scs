/* Видовая сущность для связей предметной области животного мира. */

european_hare_species
<- concept_wit_entity;
<- concept_biological_species;
=> nrel_main_idtf:
    [заяц-русак (вид)] (* <- lang_ru;; *);
    [Lepus europaeus] (* <- lang_en;; *);
=> nrel_scientific_name:
    [Lepus europaeus] (* <- lang_en;; *);
=> nrel_conservation_status: status_least_concern;
=> nrel_note:
    [биологический вид, научное название которого — Lepus europaeus] (* <- lang_ru;; *);;
