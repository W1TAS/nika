/* Экземпляры понятий предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

domestic_cow
<- concept_wit_entity;
<- concept_animal;
<- concept_mammal;
<- concept_domestic_animal;
<- concept_herbivore;
<- concept_warm_blooded_animal;
=> nrel_main_idtf:
	[домашняя корова] (* <- lang_ru;; *);
	[domestic cow] (* <- lang_en;; *);
=> nrel_note:
	[Домашняя корова — одомашненный потомок тура, основное молочное и мясное сельскохозяйственное животное.] (* <- lang_ru;; *);
=> nrel_scientific_name:
	[Bos taurus] (* <- lang_en;; *);
=> nrel_food_type: food_type_herbivory;
=> nrel_morphological_feature: feature_horn;;
