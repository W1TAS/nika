/* Видовая сущность для связей предметной области животного мира. */

common_octopus_species
<- concept_wit_entity;
<- concept_biological_species;
=> nrel_main_idtf:
    [обыкновенный осьминог (вид)] (* <- lang_ru;; *);
    [Octopus vulgaris] (* <- lang_en;; *);
=> nrel_scientific_name:
    [Octopus vulgaris] (* <- lang_en;; *);
=> nrel_conservation_status: status_least_concern;
=> nrel_note:
    [биологический вид, научное название которого — Octopus vulgaris] (* <- lang_ru;; *);;
