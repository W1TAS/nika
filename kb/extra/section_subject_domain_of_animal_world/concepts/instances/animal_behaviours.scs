=> nrel_main_idtf:
    [паразитический образ жизни] (* <- lang_ru;; *);
    [parasitic behaviour] (* <- lang_en;; *);
=> nrel_note:
    [животное питается за счёт организма-хозяина] (* <- lang_ru;; *);;
