/* Экземпляры понятия "пищевая цепь". Каждая цепь представлена кортежем,
   компоненты которого упорядочены ролевыми отношениями rrel_1, rrel_2, rrel_3. */

savanna_food_chain
<- concept_food_chain;
<- concept_wit_entity;
<- sc_node_tuple;
=> nrel_main_idtf:
	[пищевая цепь саванны] (* <- lang_ru;; *);
	[savanna food chain] (* <- lang_en;; *);
=> nrel_note:
	[травянистая растительность — равнинная зебра — лев] (* <- lang_ru;; *);
-> rrel_1: [травянистая растительность] (* <- lang_ru;; *);
-> rrel_2: plains_zebra;
-> rrel_3: lion;;

forest_food_chain
<- concept_food_chain;
<- concept_wit_entity;
<- sc_node_tuple;
=> nrel_main_idtf:
	[пищевая цепь смешанного леса] (* <- lang_ru;; *);
	[forest food chain] (* <- lang_en;; *);
=> nrel_note:
	[растительность — заяц-русак — волк] (* <- lang_ru;; *);
-> rrel_1: [лесная растительность] (* <- lang_ru;; *);
-> rrel_2: european_hare;
-> rrel_3: gray_wolf;;
