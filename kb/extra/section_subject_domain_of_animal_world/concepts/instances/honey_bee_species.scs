/* Видовая сущность для связей предметной области животного мира. */

honey_bee_species
<- concept_wit_entity;
<- concept_biological_species;
=> nrel_main_idtf:
    [медоносная пчела (вид)] (* <- lang_ru;; *);
    [Apis mellifera] (* <- lang_en;; *);
=> nrel_scientific_name:
    [Apis mellifera] (* <- lang_en;; *);
=> nrel_conservation_status: status_not_evaluated;
=> nrel_note:
    [биологический вид, научное название которого — Apis mellifera] (* <- lang_ru;; *);;
