/* Видовая сущность для связей предметной области животного мира. */

griffon_vulture_species
<- concept_wit_entity;
<- concept_biological_species;
=> nrel_main_idtf:
    [белоголовый сип (вид)] (* <- lang_ru;; *);
    [Gyps fulvus] (* <- lang_en;; *);
=> nrel_scientific_name:
    [Gyps fulvus] (* <- lang_en;; *);
=> nrel_conservation_status: status_least_concern;
=> nrel_note:
    [биологический вид, научное название которого — Gyps fulvus] (* <- lang_ru;; *);;
