/* Экземпляры понятий предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

stage_egg
<- concept_wit_entity;
<- concept_life_stage;
=> nrel_main_idtf:
	[яйцо] (* <- lang_ru;; *);
	[egg] (* <- lang_en;; *);
=> nrel_note:
	[Яйцо — начальная стадия развития многих животных, защищённая оболочкой и содержащая запас питательных веществ.] (* <- lang_ru;; *);;

stage_larva
<- concept_wit_entity;
<- concept_life_stage;
=> nrel_main_idtf:
	[личинка] (* <- lang_ru;; *);
	[larva] (* <- lang_en;; *);
=> nrel_note:
	[Личинка — стадия развития, внешне и по образу жизни отличающаяся от взрослой особи.] (* <- lang_ru;; *);;

stage_pupa
<- concept_wit_entity;
<- concept_life_stage;
=> nrel_main_idtf:
	[куколка] (* <- lang_ru;; *);
	[pupa] (* <- lang_en;; *);
=> nrel_note:
	[Куколка — покоящаяся стадия развития насекомых с полным превращением, во время которой происходит перестройка организма.] (* <- lang_ru;; *);;

stage_imago
<- concept_wit_entity;
<- concept_life_stage;
=> nrel_main_idtf:
	[имаго] (* <- lang_ru;; *);
	[imago] (* <- lang_en;; *);
=> nrel_note:
	[Имаго — окончательная стадия развития насекомого, способная к размножению.] (* <- lang_ru;; *);;

stage_tadpole
<- concept_wit_entity;
<- concept_life_stage;
=> nrel_main_idtf:
	[головастик] (* <- lang_ru;; *);
	[tadpole] (* <- lang_en;; *);
=> nrel_note:
	[Головастик — личиночная стадия земноводных, обитающая в воде и дышащая жабрами.] (* <- lang_ru;; *);;

stage_adult
<- concept_wit_entity;
<- concept_life_stage;
=> nrel_main_idtf:
	[взрослая особь] (* <- lang_ru;; *);
	[adult] (* <- lang_en;; *);
=> nrel_note:
	[Взрослая особь — стадия жизненного цикла, на которой животное способно к размножению.] (* <- lang_ru;; *);;
