/* Видовая сущность для связей предметной области животного мира. */

domestic_cow_species
<- concept_wit_entity;
<- concept_biological_species;
=> nrel_main_idtf:
    [домашняя корова (вид)] (* <- lang_ru;; *);
    [Bos taurus] (* <- lang_en;; *);
=> nrel_scientific_name:
    [Bos taurus] (* <- lang_en;; *);
=> nrel_conservation_status: status_not_evaluated;
=> nrel_note:
    [биологический вид, научное название которого — Bos taurus] (* <- lang_ru;; *);;
