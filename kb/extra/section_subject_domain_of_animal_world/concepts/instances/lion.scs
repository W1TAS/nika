/* Экземпляры понятий предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

lion
<- concept_wit_entity;
<- concept_animal;
<- concept_mammal;
<- concept_predator;
<- concept_carnivore;
<- concept_wild_animal;
<- concept_warm_blooded_animal;
<- concept_viviparous_animal;
=> nrel_main_idtf:
	[лев] (* <- lang_ru;; *);
	[lion] (* <- lang_en;; *);
=> nrel_note:
	[крупный хищник семейства кошачьих, единственный из кошек, живущий устойчивыми семейными группами — прайдами. Обитает в саваннах Африки и в Гирском лесу в Индии] (* <- lang_ru;; *);
=> nrel_scientific_name:
	[Panthera leo] (* <- lang_en;; *);
=> nrel_body_mass:
	[от 150 до 250 кг у самцов] (* <- lang_ru;; *);
=> nrel_species: panthera_leo;
=> nrel_habitat: savanna;
=> nrel_food_type: food_type_carnivory;
=> nrel_predation: plains_zebra;
=> nrel_part_of_food_chain: savanna_food_chain;
=> nrel_body_covering: covering_wool;
=> nrel_morphological_feature: feature_mane;
=> nrel_behaviour: behaviour_hunting;
=> nrel_reproduction_type: reproduction_viviparity;;
