/* Экземпляры понятий предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

plains_zebra
<- concept_wit_entity;
<- concept_animal;
<- concept_mammal;
<- concept_herbivore;
<- concept_prey;
<- concept_wild_animal;
<- concept_warm_blooded_animal;
<- concept_viviparous_animal;
=> nrel_main_idtf:
	[равнинная зебра] (* <- lang_ru;; *);
	[plains zebra] (* <- lang_en;; *);
=> nrel_note:
	[Равнинная зебра — травоядное непарнокопытное африканских саванн, известное чёрно-белым полосатым узором, который у каждой особи уникален.] (* <- lang_ru;; *);
=> nrel_scientific_name:
	[Equus quagga] (* <- lang_en;; *);
=> nrel_body_mass:
	[около 300 кг] (* <- lang_ru;; *);
=> nrel_habitat: savanna;
=> nrel_food_type: food_type_herbivory;
=> nrel_part_of_food_chain: savanna_food_chain;;
