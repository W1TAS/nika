concept_conservation_status
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[охранный статус] (* <- lang_ru;; *);
	[conservation status] (* <- lang_en;; *);
=> nrel_note:
	[Охранный статус — категория, отражающая степень риска исчезновения вида; используется, например, в Красном списке МСОП.] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (охранный статус)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Охранный статус — категория, присваиваемая биологическому виду и отражающая вероятность его исчезновения в естественной среде.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_biological_species;
				concept_red_book
			};;
	*);;
