/* Абсолютное понятие предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

concept_habitat
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[местообитание] (* <- lang_ru;; *);
	[habitat] (* <- lang_en;; *);
=> nrel_note:
	[Местообитание — участок среды, в котором обитает популяция или отдельная особь и который обеспечивает её пищей, укрытием и условиями размножения.] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (местообитание)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Местообитание — часть природной среды, обладающая условиями, необходимыми для жизни конкретного вида животных.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_animal;
				concept_ecosystem
			};;
	*);;
