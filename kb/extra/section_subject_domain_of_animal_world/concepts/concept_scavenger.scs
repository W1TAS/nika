/* Абсолютное понятие предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

concept_scavenger
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[падальщик] (* <- lang_ru;; *);
	[scavenger] (* <- lang_en;; *);
=> nrel_note:
	[Падальщики — животные, питающиеся трупами других животных и играющие роль санитаров экосистемы.] (* <- lang_ru;; *);
<= nrel_inclusion: concept_animal;
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (падальщик)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Падальщик — животное, основу питания которого составляют останки погибших животных.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_animal
			};;
	*);;
