<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (пищевая цепь)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Пищевая цепь — упорядоченная последовательность организмов, связанных отношением «быть пищей», по которой происходит передача вещества и энергии в экосистеме.] (* <- lang_ru;; *);;
			*);;
