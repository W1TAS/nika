/* Абсолютное понятие предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

concept_food_type
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[тип питания] (* <- lang_ru;; *);
	[food type] (* <- lang_en;; *);
=> nrel_note:
	[Тип питания — характеристика животного, определяемая составом его рациона: травоядность, плотоядность, всеядность и другие.] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (тип питания)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Тип питания — класс, характеризующий состав рациона животного и способ добывания им пищи.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_animal
			};;
	*);;
