/* Абсолютное понятие предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

concept_predator
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[хищник] (* <- lang_ru;; *);
	[predator] (* <- lang_en;; *);
=> nrel_note:
	[Хищник — животное, которое добывает пищу, охотясь на других животных и умерщвляя их.] (* <- lang_ru;; *);
<= nrel_inclusion: concept_animal;
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (хищник)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Хищник — животное, которое добывает пищу путём охоты на других животных, являющихся для него жертвами.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_animal;
				concept_prey
			};;
	*);;
