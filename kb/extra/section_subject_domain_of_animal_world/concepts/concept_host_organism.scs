/* Абсолютное понятие предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

concept_host_organism
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[организм-хозяин] (* <- lang_ru;; *);
	[host organism] (* <- lang_en;; *);
=> nrel_note:
	[Организм-хозяин — организм, за счёт которого живёт паразит или с которым связан симбионт.] (* <- lang_ru;; *);
<= nrel_inclusion: concept_animal;
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (организм-хозяин)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Организм-хозяин — животное, на котором или внутри которого обитает паразит либо симбионт.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_animal;
				concept_parasite
			};;
	*);;
