/* Абсолютное понятие предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

concept_morphological_feature
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[морфологический признак] (* <- lang_ru;; *);
	[morphological feature] (* <- lang_en;; *);
=> nrel_note:
	[Морфологический признак — внешняя особенность строения тела животного, используемая при его описании и определении.] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (морфологический признак)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Морфологический признак — особенность внешнего строения животного, по которой его можно отличить от животных других видов.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_animal
			};;
	*);;
