/* Абсолютное понятие предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

concept_animal_behaviour
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[поведение животного] (* <- lang_ru;; *);
	[animal behaviour] (* <- lang_en;; *);
=> nrel_note:
	[Поведение животного — совокупность действий животного, направленных на приспособление к среде обитания: охота, миграция, спячка, брачные ритуалы.] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (поведение животного)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Поведение животного — совокупность реакций и действий животного, обеспечивающих его приспособление к условиям среды обитания.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_animal;
				concept_habitat
			};;
	*);;
