/* Абсолютное понятие предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

concept_oviparous_animal
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[яйцекладущее животное] (* <- lang_ru;; *);
	[oviparous animal] (* <- lang_en;; *);
=> nrel_note:
	[Яйцекладущие животные размножаются, откладывая яйца, развитие зародыша происходит вне организма матери.] (* <- lang_ru;; *);
<= nrel_inclusion: concept_animal;
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (яйцекладущее животное)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Яйцекладущее животное — животное, размножение которого происходит путём откладывания яиц.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_animal;
				concept_reproduction_type
			};;
	*);;
