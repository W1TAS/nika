/* Абсолютное понятие предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

concept_life_stage
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[стадия жизненного цикла] (* <- lang_ru;; *);
	[life stage] (* <- lang_en;; *);
=> nrel_note:
	[Стадия жизненного цикла — качественно своеобразный этап индивидуального развития животного, например яйцо, личинка, куколка, имаго.] (* <- lang_ru;; *);
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (стадия жизненного цикла)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Стадия жизненного цикла — этап индивидуального развития животного, отличающийся строением и образом жизни особи.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_animal
			};;
	*);;
