/* Абсолютное понятие предметной области животного мира.
   Формализовано в рамках лабораторной работы №1 по курсу ТиИСПИС. */

concept_wild_animal
<- sc_node_class;
<- class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[дикое животное] (* <- lang_ru;; *);
	[wild animal] (* <- lang_en;; *);
=> nrel_note:
	[Дикое животное — животное, обитающее в естественной среде и не одомашненное человеком.] (* <- lang_ru;; *);
<= nrel_inclusion: concept_animal;
<- rrel_key_sc_element:
	...
	(*
		<- definition;;
		=> nrel_main_idtf:
			[Опр. (дикое животное)] (* <- lang_ru;; *);;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Дикое животное — животное, жизненный цикл которого проходит в естественной среде обитания без участия человека.] (* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_animal
			};;
	*);;
